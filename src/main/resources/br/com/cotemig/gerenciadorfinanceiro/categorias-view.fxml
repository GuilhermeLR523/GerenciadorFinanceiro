<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.cotemig.gerenciadorfinanceiro.controller.CategoriaController"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Categorias"
           styleClass="titulo-pagina"/>

    <HBox spacing="10">

        <Button text="+ Nova Categoria"
                styleClass="botao-principal"
                onAction="#abrirNovaCategoria"/>

        <Button text="Desativar / Reativar"
                onAction="#alterarStatus"/>

        <Button text="Excluir"
                styleClass="botao-excluir"
                onAction="#excluirCategoria"/>

    </HBox>

    <Label fx:id="labelMensagem"
           styleClass="mensagem"
           wrapText="true"/>

    <TableView fx:id="tabelaCategorias"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colunaNome"
                         text="Nome"
                         prefWidth="220"/>

            <TableColumn fx:id="colunaTipo"
                         text="Tipo"
                         prefWidth="160"/>

            <TableColumn fx:id="colunaStatus"
                         text="Status"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>