<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.cotemig.gerenciadorfinanceiro.controller.NovaTransacaoController"
      spacing="10"
      prefWidth="450">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Nova Transação"
           styleClass="titulo-pagina"/>

    <Label text="Descrição"/>

    <TextField fx:id="campoDescricao"
               promptText="Ex.: Supermercado"/>

    <Label text="Tipo"/>

    <ComboBox fx:id="comboTipo"
              maxWidth="Infinity"
              promptText="Selecione o tipo"
              onAction="#tipoAlterado"/>

    <Label text="Valor"/>

    <TextField fx:id="campoValor"
               promptText="Ex.: 200,00"/>

    <Label text="Data"/>

    <DatePicker fx:id="campoData"
                maxWidth="Infinity"/>

    <Label text="Conta"/>

    <ComboBox fx:id="comboConta"
              maxWidth="Infinity"
              promptText="Selecione a conta"/>

    <Label text="Categoria"/>

    <ComboBox fx:id="comboCategoria"
              maxWidth="Infinity"
              promptText="Selecione primeiro o tipo"/>

    <Label text="Observações"/>

    <TextArea fx:id="campoObservacoes"
              promptText="Observações opcionais"
              prefRowCount="3"
              wrapText="true"/>

    <Label fx:id="labelMensagem"
           styleClass="mensagem"
           wrapText="true"/>

    <HBox spacing="10">

        <Button text="Cadastrar"
                styleClass="botao-principal"
                onAction="#cadastrar"/>

        <Button text="Cancelar"
                onAction="#cancelar"/>

    </HBox>

</VBox>