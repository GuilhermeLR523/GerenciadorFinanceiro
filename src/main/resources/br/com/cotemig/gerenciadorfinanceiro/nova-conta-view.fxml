<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.cotemig.gerenciadorfinanceiro.controller.NovaContaController"
      spacing="15"
      prefWidth="400">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Nova Conta"
           styleClass="titulo-pagina"/>

    <Label text="Nome"/>

    <TextField fx:id="campoNome"
               promptText="Ex.: Nubank"/>

    <Label text="Tipo da conta"/>

    <ComboBox fx:id="comboTipo"
              maxWidth="Infinity"
              promptText="Selecione o tipo"/>

    <Label text="Saldo inicial"/>

    <TextField fx:id="campoSaldoInicial"
               promptText="Ex.: 1500,00"/>

    <Label fx:id="labelMensagem"
           styleClass="mensagem"
           wrapText="true"/>

    <HBox spacing="10">

        <Button text="Cadastrar"
                styleClass="botao-principal"
                onAction="#cadastrar"/>

        <Button text="Cancelar"
                onAction="#cancelar"/>

    </HBox>

</VBox>