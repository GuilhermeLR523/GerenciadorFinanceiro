<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.cotemig.gerenciadorfinanceiro.controller.TransacaoController"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Transações"
           styleClass="titulo-pagina"/>

    <HBox spacing="10">

        <Button text="+ Nova Transação"
                styleClass="botao-principal"
                onAction="#abrirNovaTransacao"/>

        <Button text="Excluir"
                styleClass="botao-excluir"
                onAction="#excluirTransacao"/>

    </HBox>

    <Label fx:id="labelMensagem"
           styleClass="mensagem"
           wrapText="true"/>

    <TableView fx:id="tabelaTransacoes"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colunaData"
                         text="Data"
                         prefWidth="100"/>

            <TableColumn fx:id="colunaDescricao"
                         text="Descrição"
                         prefWidth="180"/>

            <TableColumn fx:id="colunaTipo"
                         text="Tipo"
                         prefWidth="100"/>

            <TableColumn fx:id="colunaCategoria"
                         text="Categoria"
                         prefWidth="130"/>

            <TableColumn fx:id="colunaConta"
                         text="Conta"
                         prefWidth="130"/>

            <TableColumn fx:id="colunaValor"
                         text="Valor"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>