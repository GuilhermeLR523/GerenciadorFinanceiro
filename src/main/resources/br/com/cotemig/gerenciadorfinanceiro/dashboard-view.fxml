<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.cotemig.gerenciadorfinanceiro.controller.DashboardController"
      spacing="25">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Dashboard"
           styleClass="titulo-pagina"/>

    <GridPane hgap="20"
              vgap="20">

        <VBox GridPane.columnIndex="0"
              GridPane.rowIndex="0"
              spacing="8"
              prefWidth="200"
              styleClass="card">

            <Label text="Saldo Total"
                   styleClass="card-titulo"/>

            <Label fx:id="labelSaldoTotal"
                   text="R$ 0,00"
                   styleClass="card-valor"/>

        </VBox>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="0"
              spacing="8"
              prefWidth="200"
              styleClass="card">

            <Label text="Receitas do Mês"
                   styleClass="card-titulo"/>

            <Label fx:id="labelReceitas"
                   text="R$ 0,00"
                   styleClass="card-valor"/>

        </VBox>

        <VBox GridPane.columnIndex="0"
              GridPane.rowIndex="1"
              spacing="8"
              prefWidth="200"
              styleClass="card">

            <Label text="Despesas do Mês"
                   styleClass="card-titulo"/>

            <Label fx:id="labelDespesas"
                   text="R$ 0,00"
                   styleClass="card-valor"/>

        </VBox>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="1"
              spacing="8"
              prefWidth="200"
              styleClass="card">

            <Label text="Metas Ativas"
                   styleClass="card-titulo"/>

            <Label fx:id="labelMetasAtivas"
                   text="0"
                   styleClass="card-valor"/>

        </VBox>

    </GridPane>

    <Label text="Transações Recentes"
           styleClass="subtitulo"/>

    <TableView fx:id="tabelaTransacoesRecentes"
               prefHeight="230"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colunaData"
                         text="Data"
                         prefWidth="100"/>

            <TableColumn fx:id="colunaDescricao"
                         text="Descrição"
                         prefWidth="200"/>

            <TableColumn fx:id="colunaTipo"
                         text="Tipo"
                         prefWidth="100"/>

            <TableColumn fx:id="colunaConta"
                         text="Conta"
                         prefWidth="140"/>

            <TableColumn fx:id="colunaValor"
                         text="Valor"
                         prefWidth="130"/>

        </columns>

    </TableView>

</VBox>